{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xilveno-dentalcare",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-03",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "routes": [
    {
      "pattern": "dental.xilveno.shop",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./src/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*", "/robots.txt", "/sitemap.xml", "/favicon.svg"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xilveno-dentalcare-db",
      "database_id": "0f60a0e2-5045-4b3b-880d-fd104b0c922f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xilveno-dentalcare-media"
    }
  ],
  "vars": {
    "CANONICAL_BASE": "https://dental.xilveno.shop"
  },
  "observability": {
    "enabled": true
  }
}
